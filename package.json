{
  "name": "Crowdspawn",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "contracts": "pnpm --filter api openapi && pnpm --filter @repo/contracts generate",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "cd apps/api && uv sync"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
