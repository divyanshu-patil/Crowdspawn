# Copy to .env and fill in the keys at the bottom. Never commit .env.
APP_ENV=development

# Qloo
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_RPS=4
QLOO_MAX_CALLS_PER_RUN=120
QLOO_CACHE_TTL_SECONDS=86400
QLOO_TIMEOUT_SECONDS=20

# LLM: ollama_cloud | gemini | openai_compat | fake
LLM_PROVIDER=ollama_cloud
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
GEMINI_MODEL=gemini-2.5-flash
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# App
DATABASE_PATH=./data/crowdspawn.sqlite3
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
PLANS_PER_IP_PER_HOUR=10

# ---------- secrets ----------
QLOO_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=
