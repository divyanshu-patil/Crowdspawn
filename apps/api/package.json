{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn crowdspawn_api.main:app --reload --reload-dir src --port 8000",
    "build": "uv run --no-sync python scripts/export_openapi.py",
    "openapi": "uv run --no-sync python scripts/export_openapi.py",
    "test": "uv run --no-sync pytest --cov=crowdspawn_api --cov-report=term-missing:skip-covered --cov-fail-under=80",
    "test:live": "uv run --no-sync pytest -m live -o addopts=''",
    "lint": "uv run --no-sync ruff check src scripts tests && uv run --no-sync ruff format --check src scripts tests",
    "check-types": "uv run --no-sync mypy"
  }
}
